{
  "name": "allocait-trading-agent-example",
  "version": "0.1.0",
  "private": true,
  "description": "Check a proposed order against your own Allocait rules before your bot places it. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env check.mjs order.example.json",
    "bot": "node --env-file-if-exists=.env bot.mjs order.example.json",
    "test": "node --test \"test/*.test.mjs\""
  }
}
