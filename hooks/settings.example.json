{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(^|__)(place_[a-z_]+|close_position|close_all_positions|replace_order_by_id|exercise_options_position|do_not_exercise_options_position|update_account_config)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-check.mjs\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
