# Copy to .env and fill in, then: node --env-file=.env check.mjs order.example.json

# Allocait app, Settings, API keys tab. A Read only key checks; a Read and change key also records.
ALLOCAIT_API_KEY=
# A check with this blank lists your portfolios and their ids.
ALLOCAIT_PORTFOLIO_ID=

# file:<path>, coinbase (pairs, no key) or alpaca; a comma list tries each in turn. Python reads file:<path> only.
PRICE_SOURCE=file:prices.example.json

# The order bot.mjs and python/bot.py read when none is given on the command line (see strategy.mjs).
# ORDER_FILE=order.example.json

# none records in Allocait only; alpaca places the order in your Alpaca paper account first.
# Paper is the default; see docs/SCRIPT.md for the live-URL refusal.
# ALPACA_BASE_URL=
# ALLOW_LIVE_TRADING=
BROKER=none
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
