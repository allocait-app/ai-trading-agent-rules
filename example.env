# Copy to .env and fill in, then: node --env-file=.env check.mjs order.example.json

# Allocait app, Settings > Agents. A Read only key checks; a Read and change key also records.
ALLOCAIT_API_KEY=
# A check with this blank lists your portfolios and their ids.
ALLOCAIT_PORTFOLIO_ID=

# file:<path>, coinbase (pairs, no key) or alpaca; a comma list tries each in turn.
PRICE_SOURCE=file:prices.example.json

# none records in Allocait only; alpaca places the order in your Alpaca paper account first.
BROKER=none
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
